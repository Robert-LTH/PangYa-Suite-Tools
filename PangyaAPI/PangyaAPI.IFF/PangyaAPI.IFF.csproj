<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>PangyaAPI.IFF</PackageId>
    <Title>PangyaAPI IFF</Title>
    <Description>Read, index, edit, validate, and atomically write multi-region schema-driven PangYa IFF files and containers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PangyaAPI.Utilities\PangyaAPI.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas\Defaults\*.json" WithCulture="false" />
  </ItemGroup>
</Project>
